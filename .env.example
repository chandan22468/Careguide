# ==========================================
# CareGuide Environment Variables Example
# ==========================================

# --- Backend Settings ---
APP_NAME=CareGuide API
ENVIRONMENT=production
API_V1_PREFIX=/api
MONGODB_URI=
MONGODB_DATABASE=careguide
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_GROUNDING_THRESHOLD=0.34
IMAGEKIT_PRIVATE_KEY=
AUTH_JWT_SECRET=
AUTH_COOKIE_NAME=careguide_auth
AUTH_COOKIE_MAX_AGE=1209600
MAX_UPLOAD_BYTES=10485760

# --- Frontend Settings ---
VITE_API_BASE_URL=/api

